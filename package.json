{
  "name": "carnetbotanique",
  "private": true,
  "description": "L'Herbier de Vie — carnet de botanique premium (PWA statique, sans build)",
  "type": "module",
  "scripts": {
    "build": "npm run build:assets && npm run build:seo",
    "build:assets": "node scripts/build-assets.mjs",
    "test": "node tests/e2e.mjs",
    "test:pwa": "node tests/pwa-update.mjs",
    "test:phase0": "node tests/phase0.mjs",
    "test:phase0:strict": "node tests/phase0.mjs --strict",
    "test:phase2": "node tests/phase2-responsive-nav.mjs",
    "test:phase3": "node tests/phase0.mjs --strict",
    "test:phase4": "node scripts/check-performance-budget.mjs",
    "test:phase5": "node scripts/check-professional-polish.mjs",
    "test:phase6": "node scripts/check-secondary-polish.mjs",
    "test:phase7": "node scripts/check-phase7-performance.mjs",
    "test:phase7:ci": "node scripts/check-phase7-performance.mjs --require-reports",
    "test:phase8": "node scripts/check-phase8-ux.mjs",
    "test:phase9": "node scripts/check-phase9-maturity.mjs",
    "test:phase9:static": "node scripts/check-phase9-maturity.mjs --static",
    "test:sw-version": "node scripts/check-sw-version.mjs",
    "test:sw-version:strict": "node scripts/check-sw-version.mjs --strict",
    "test:all": "npm run build:assets && npm test && npm run test:pwa && npm run test:phase3 && npm run test:phase2 && npm run test:phase5 && npm run test:phase6 && npm run test:phase7 && npm run test:phase8 && npm run test:phase9 && npm run test:sw-version:strict",
    "build:seo": "node scripts/build-seo.mjs",
    "serve:prod": "node scripts/serve-production.mjs 8892"
  },
  "devDependencies": {
    "axe-core": "^4.12.1",
    "esbuild": "^0.25.12",
    "playwright": "^1.45.0"
  }
}
