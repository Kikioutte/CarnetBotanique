{
  "name": "carnetbotanique",
  "private": true,
  "description": "L'Herbier de Vie — carnet de botanique premium (PWA statique, sans build)",
  "type": "module",
  "scripts": {
    "test": "node tests/e2e.mjs",
    "test:pwa": "node tests/pwa-update.mjs",
    "test:phase0": "node tests/phase0.mjs",
    "test:phase0:strict": "node tests/phase0.mjs --strict",
    "test:sw-version": "node scripts/check-sw-version.mjs",
    "test:sw-version:strict": "node scripts/check-sw-version.mjs --strict",
    "test:all": "npm test && npm run test:pwa && npm run test:phase0 && npm run test:sw-version:strict",
    "build:seo": "node scripts/build-seo.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.12.1",
    "playwright": "^1.45.0"
  }
}
